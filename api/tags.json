---
layout: none
permalink: /api/tags.json
---
{% comment %} Collect the unique set of tags across all content collections {% endcomment %}
{% assign all_items = site.posts | concat: site.articles | concat: site.solutions | concat: site.locations | concat: site.events %}
{% assign all_tags = "" | split: "" %}
{% for item in all_items %}
  {% for tag in item.tags %}
    {% unless all_tags contains tag %}
      {% assign all_tags = all_tags | push: tag %}
    {% endunless %}
  {% endfor %}
{% endfor %}
{% assign all_tags = all_tags | sort_natural %}
[
  {% for tag in all_tags %}
  {% assign t_posts     = site.posts     | where_exp: "i", "i.tags contains tag" %}
  {% assign t_articles  = site.articles  | where_exp: "i", "i.tags contains tag" %}
  {% assign t_solutions = site.solutions | where_exp: "i", "i.tags contains tag" %}
  {% assign t_locations = site.locations | where_exp: "i", "i.tags contains tag" %}
  {% assign t_events    = site.events    | where_exp: "i", "i.tags contains tag" %}
  {% assign t_total = t_posts.size | plus: t_articles.size | plus: t_solutions.size | plus: t_locations.size | plus: t_events.size %}
  {
    "name": {{ tag | jsonify }},
    "slug": {{ tag | slugify: 'latin' | jsonify }},
    "url": "{{ site.url }}/tags/{{ tag | slugify: 'latin' }}/",
    "count": {{ t_total }},
    "counts": {
      "posts": {{ t_posts.size }},
      "articles": {{ t_articles.size }},
      "solutions": {{ t_solutions.size }},
      "locations": {{ t_locations.size }},
      "events": {{ t_events.size }}
    },
    "posts": [
      {% for i in t_posts %}{ "title": {{ i.title | jsonify }}, "url": "{{ site.url }}{{ i.url }}" }{% unless forloop.last %},{% endunless %}{% endfor %}
    ],
    "articles": [
      {% for i in t_articles %}{ "title": {{ i.title | jsonify }}, "url": "{{ site.url }}{{ i.url }}" }{% unless forloop.last %},{% endunless %}{% endfor %}
    ],
    "solutions": [
      {% for i in t_solutions %}{ "title": {{ i.title | jsonify }}, "url": "{{ site.url }}{{ i.url }}" }{% unless forloop.last %},{% endunless %}{% endfor %}
    ],
    "locations": [
      {% for i in t_locations %}{ "title": {{ i.title | jsonify }}, "url": "{{ site.url }}{{ i.url }}" }{% unless forloop.last %},{% endunless %}{% endfor %}
    ],
    "events": [
      {% for i in t_events %}{ "title": {{ i.title | jsonify }}, "url": "{{ site.url }}{{ i.url }}" }{% unless forloop.last %},{% endunless %}{% endfor %}
    ]
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
